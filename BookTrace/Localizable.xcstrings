    "This device has no camera to scan with. On the Simulator, search by title or ISBN instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no camera to scan with. On the Simulator, search by title or ISBN instead."
          }
        },
