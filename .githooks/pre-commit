#!/bin/sh
#
# Staged içerikte API anahtarı varsa commit'i durdurur.
# Kurulum (her klonda bir kez):  git config core.hooksPath .githooks
#
# Hook'un kendisi taramanın dışında: içinde arama deseni olarak anahtar
# biçimi geçiyor, yoksa kendi kendini engellerdi.

diff=$(git diff --cached -U0 -- . ':(exclude).githooks/*')

# Eklenen satırları dosya adıyla etiketler. Eskiden yalnızca satırlar
# toplanıyor, hata mesajı ise staged olan *bütün* dosyaları listeliyordu;
# 140 dosyalık bir listede hangi satırın suçlu olduğu görünmüyordu.
added=$(printf '%s\n' "$diff" | awk '
    /^\+\+\+ / { file = ($2 == "/dev/null") ? "" : substr($2, 3); next }
    /^\+/      { if (file != "") print file ": " substr($0, 2) }
')

# 1) Google API anahtarı biçimi (AIza ile başlayan uzun dizi).
keys=$(printf '%s\n' "$added" | grep 'AIza[0-9A-Za-z_-]\{20,\}')

# 2) Doldurulmuş GOOGLE_BOOKS_API_KEY satırı.
#    Değerin gerçekten anahtar gibi görünmesi aranır: en az 8 harf/rakam.
#    Bu eşik olmadan aşağıdakiler yanlış alarm üretiyordu — hepsi geçerli
#    ve anahtarsız kullanımlar:
#      KEY=  \        kabuk satır devamı (ci.yml'deki xcodebuild çağrıları)
#      KEY: ''        boş YAML değeri
#      KEY = %s       printf biçim dizesi (README'deki CI örneği)
filled=$(printf '%s\n' "$added" \
         | grep 'GOOGLE_BOOKS_API_KEY[ ]*[=:][^A-Za-z0-9_-]*[A-Za-z0-9_-]\{8,\}' \
         | grep -v 'GOOGLE_BOOKS_API_KEY[ ]*=[ ]*\$(' \
         | grep -v 'buraya_kendi_anahtarinizi_yazin' \
         | grep -v 'YOUR_GOOGLE_BOOKS_API_KEY')

if [ -n "$keys" ] || [ -n "$filled" ]; then
    echo ""
    echo "COMMIT DURDURULDU: staged değişikliklerde API anahtarı var."
    echo ""
    echo "Suçlu satırlar (değer maskeli):"
    printf '%s\n%s\n' "$keys" "$filled" \
        | grep -v '^$' \
        | sort -u \
        | sed -e 's/AIza[0-9A-Za-z_-]*/AIza<MASKELENDI>/g' \
              -e 's/\(GOOGLE_BOOKS_API_KEY[ ]*[=:][^A-Za-z0-9_-]*\)[A-Za-z0-9_-]\{8,\}/\1<MASKELENDI>/g' \
        | sed 's/^/  /'
    echo ""
    echo "Anahtar yalnizca Config/Secrets.xcconfig icinde durmali; o dosya"
    echo ".gitignore'da oldugu icin commit'e zaten giremez. Anahtari baska"
    echo "bir dosyaya yazdiysan oradan sil, ornegin:"
    echo ""
    echo "  git restore Config/Shared.xcconfig"
    echo ""
    echo "Bilerek commitliyorsan: git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
