{
  "sourceLanguage" : "en",
  "strings" : {
    "Your library is yours. No BookTrace account needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library is yours. No BookTrace account needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanen sana ait. BookTrace hesabı gerekmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek gehört dir. Kein BookTrace-Konto nötig."
          }
        }
      }
    },
    "Books, sessions, notes, quotes, and goals stored on this device will be deleted. This local reset cannot be undone. Data already in iCloud may download again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books, sessions, notes, quotes, and goals stored on this device will be deleted. This local reset cannot be undone. Data already in iCloud may download again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki kitaplar, oturumlar, notlar, alıntılar ve hedefler silinecek. Bu yerel sıfırlama geri alınamaz. iCloud’daki veriler yeniden indirilebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bücher, Sitzungen, Notizen, Zitate und Ziele auf diesem Gerät werden gelöscht. Dieses lokale Zurücksetzen kann nicht rückgängig gemacht werden. Daten aus iCloud können erneut geladen werden."
          }
        }
      }
    },
