        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sonuçları çevrimdışı gezinmek için bu cihazda önbelleğe alınır. Kütüphaneyi silmek tüm kitapları, okuma oturumlarını, notları, alıntıları ve hedefleri kaldırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchergebnisse werden für die Offline-Nutzung auf diesem Gerät zwischengespeichert. Das Löschen der Bibliothek entfernt alle Bücher, Lesesitzungen, Notizen, Zitate und Ziele."
          }
        }
