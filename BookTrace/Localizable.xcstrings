    "Search results are cached on this device for a day. Erasing the library removes all %lld books and their reading sessions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results are cached on this device for a day. Erasing the library removes all %lld books and their reading sessions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sonuçları bu cihazda bir gün saklanır. Kütüphaneyi silmek %lld kitabın tamamını ve okuma oturumlarını kaldırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchergebnisse werden einen Tag lang auf diesem Gerät gespeichert. Das Löschen der Bibliothek entfernt alle %lld Bücher und ihre Lesesitzungen."
          }
        }
      }
    },
