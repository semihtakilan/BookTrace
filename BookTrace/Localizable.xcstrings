    "This is the starting assumption. After your first reading session it is replaced by your own measured pace.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the starting assumption. After your first reading session it is replaced by your own measured pace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlangıç varsayımı. İlk okuma oturumundan sonra yerini kendi ölçülen hızın alır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Ausgangsannahme. Nach deiner ersten Lesesitzung wird sie durch dein gemessenes Tempo ersetzt."
          }
        }
      }
    },
