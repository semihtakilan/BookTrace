    "Add a book to your library and record a reading session — your stats will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a book to your library and record a reading session — your stats will show up here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanene bir kitap ekle ve bir okuma oturumu kaydet — istatistiklerin burada görünecek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Buch zu deiner Bibliothek hinzu und zeichne eine Lesesitzung auf – deine Statistiken erscheinen hier."
          }
        }
      }
    },
