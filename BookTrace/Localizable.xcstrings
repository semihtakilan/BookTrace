    "7 days free, then %@ per year. Renews automatically unless canceled. Cancel in Apple subscriptions at least 24 hours before the trial ends to avoid being charged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 days free, then %@ per year. Renews automatically unless canceled. Cancel in Apple subscriptions at least 24 hours before the trial ends to avoid being charged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün ücretsiz, ardından yıllık %@. İptal edilmezse otomatik yenilenir. Ücret alınmaması için deneme bitmeden en az 24 saat önce Apple aboneliklerinden iptal et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage kostenlos, danach %@ pro Jahr. Verlängert sich automatisch, sofern nicht gekündigt. Kündige mindestens 24 Stunden vor Ende der Testphase in den Apple-Abonnements, um eine Abbuchung zu vermeiden."
          }
        }
      }
    },
    "%@ per year. Renews automatically unless canceled at least 24 hours before the current period ends. Manage or cancel in Apple subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per year. Renews automatically unless canceled at least 24 hours before the current period ends. Manage or cancel in Apple subscriptions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık %@. Geçerli dönem bitmeden en az 24 saat önce iptal edilmezse otomatik yenilenir. Apple aboneliklerinden yönetebilir veya iptal edebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Jahr. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt. Verwalten oder kündigen in den Apple-Abonnements."
          }
        }
      }
    },
    "%@ per month. Renews automatically unless canceled at least 24 hours before the current period ends. Manage or cancel in Apple subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per month. Renews automatically unless canceled at least 24 hours before the current period ends. Manage or cancel in Apple subscriptions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık %@. Geçerli dönem bitmeden en az 24 saat önce iptal edilmezse otomatik yenilenir. Apple aboneliklerinden yönetebilir veya iptal edebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt. Verwalten oder kündigen in den Apple-Abonnements."
          }
        }
      }
    },
    "%@ as a one-time purchase. No subscription or automatic renewal.": {
