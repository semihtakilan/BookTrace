    "A closer look at your reading life, with tools to make it your own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closer look at your reading life, with tools to make it your own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma alışkanlıklarını yakından tanı, sana uygun araçlarla geliştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke deine Lesegewohnheiten und gestalte sie mit passenden Werkzeugen."
          }
        }
      }
    },
    "Unlimited books, reading sessions, and iCloud sync stay free.": {
      "extractionState": "manual",
