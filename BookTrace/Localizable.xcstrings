    "Search results are cached on this device so browsing works offline and uses fewer requests. Erasing the library removes all %lld books and their reading sessions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchergebnisse werden auf diesem Gerät gespeichert, damit das Stöbern offline funktioniert und weniger Anfragen benötigt. Beim Löschen der Bibliothek werden alle %lld Bücher und ihre Lesesitzungen entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results are cached on this device so browsing works offline and uses fewer requests. Erasing the library removes all %lld books and their reading sessions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sonuçları bu cihazda saklanıyor; böylece çevrimdışı da gezinebiliyor ve daha az istek harcıyorsunuz. Kütüphaneyi silmek %lld kitabın tamamını ve okuma oturumlarını kaldırır."
          }
        }
      }
    },
    "Search, browse a shelf or scan a barcode in Explore to add your first book.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, browse a shelf or scan a barcode in Explore to add your first book."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kitabını eklemek için Keşfet'te arama yap, raflara göz at ya da barkod tara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche, stöbere in einem Regal oder scanne einen Barcode unter Entdecken, um dein erstes Buch hinzuzufügen."
          }
        }
      }
    },
    "Searches will be fetched fresh from Google Books.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
