    "Keep your reading close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your reading close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuman hep yanında"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lesen immer dabei"
          }
        }
      }
    },
    "See your current book, reading streak and goals at a glance with BookTrace Pro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your current book, reading streak and goals at a glance with BookTrace Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BookTrace Pro ile okuduğun kitabı, okuma serini ve hedeflerini bir bakışta gör."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh mit BookTrace Pro dein aktuelles Buch, deine Leseserie und deine Ziele auf einen Blick."
          }
        }
      }
    },
    "Home Screen & Lock Screen widgets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Screen & Lock Screen widgets"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran ve Kilit Ekranı araç takımları"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets für Home- und Sperrbildschirm"
          }
        }
      }
    },
    "Open the widget gallery from your Home Screen, search for BookTrace, then choose a book, streak or goal widget.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the widget gallery from your Home Screen, search for BookTrace, then choose a book, streak or goal widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekranından araç takımı galerisini aç, BookTrace’i ara ve kitap, seri veya hedef araç takımını seç."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Widget-Galerie auf deinem Home-Bildschirm, suche nach BookTrace und wähle ein Buch-, Serien- oder Ziel-Widget."
          }
        }
      }
    },
    "For a Lock Screen widget, customize your Lock Screen and select BookTrace from the widget gallery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a Lock Screen widget, customize your Lock Screen and select BookTrace from the widget gallery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit Ekranı araç takımı için Kilit Ekranını özelleştir ve araç takımı galerisinden BookTrace’i seç."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe für ein Sperrbildschirm-Widget deinen Sperrbildschirm an und wähle BookTrace aus der Widget-Galerie."
          }
        }
      }
    },
    "Open BookTrace once before setting up your widgets. Saving a reading session or updating a goal refreshes their content.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open BookTrace once before setting up your widgets. Saving a reading session or updating a goal refreshes their content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç takımlarını ayarlamadan önce BookTrace’i bir kez aç. Okuma oturumu kaydetmek veya hedef güncellemek içeriklerini yeniler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne BookTrace einmal, bevor du Widgets einrichtest. Wenn du eine Lesesitzung speicherst oder ein Ziel aktualisierst, wird ihr Inhalt erneuert."
          }
        }
      }
    },
    "With Pro active, start a reading session from a saved book. When allowed by iOS, its timer appears on the Lock Screen and Dynamic Island.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Pro active, start a reading session from a saved book. When allowed by iOS, its timer appears on the Lock Screen and Dynamic Island."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro etkinken kayıtlı bir kitaptan okuma oturumu başlat. iOS izin veriyorsa sayaç Kilit Ekranında ve Dynamic Island’da görünür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit aktivem Pro eine Lesesitzung aus einem gespeicherten Buch. Wenn iOS es erlaubt, erscheint der Timer auf dem Sperrbildschirm und in der Dynamic Island."
          }
        }
      }
    },
    "Pause, resume, save or cancel the session in BookTrace. The Lock Screen timer follows those changes. Reading sessions work without Pro too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause, resume, save or cancel the session in BookTrace. The Lock Screen timer follows those changes. Reading sessions work without Pro too."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu BookTrace’te duraklat, sürdür, kaydet veya iptal et. Kilit Ekranındaki sayaç bu değişiklikleri izler. Okuma oturumları Pro olmadan da çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere, starte, speichere oder beende die Sitzung in BookTrace. Der Sperrbildschirm-Timer folgt diesen Änderungen. Lesesitzungen funktionieren auch ohne Pro."
          }
        }
      }
    },
    "If the timer does not appear, check that Live Activities are enabled for BookTrace in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the timer does not appear, check that Live Activities are enabled for BookTrace in iOS Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç görünmezse iOS Ayarlarında BookTrace için Canlı Etkinliklerin açık olduğunu kontrol et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Timer nicht erscheint, prüfe in den iOS-Einstellungen, ob Live-Aktivitäten für BookTrace aktiviert sind."
          }
        }
      }
    },
