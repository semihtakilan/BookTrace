// Anahtarın varsayılanı boş: depoyu yeni klonlayan biri hiçbir şey yapmadan
// derleyebilsin. Boş anahtarla uygulama çalışır, yalnızca Google'ın kota
// hatasını gösterir. Bu satırın sağı BOŞ KALMALI.
GOOGLE_BOOKS_API_KEY =

// Gerçek anahtarı aşağıdaki dosya getirir. Yoksa derleme yine de sürer.
#include? "Secrets.xcconfig"
